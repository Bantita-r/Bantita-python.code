"""
ขอให้สร้าง function ชื่อ deposit(money) ที่เป็นโปรแกรมจำลองการฝากเงินเข้าบัญชี 
โดยกำหนดยอดเงินเริ่มต้นเป็น 1,000 บาท โปรแกรมต้องรับจำนวนเงินที่ต้องการฝากจากผู้ใช้ 1 ครั้ง 
แล้วคำนวณยอดคงเหลือใหม่

ใช้ try-except เพื่อจัดการกรณีผู้ใช้กรอกข้อมูลที่แปลงเป็นตัวเลขไม่ได้ เช่น abc
หากจำนวนเงินฝากน้อยกว่าหรือเท่ากับ 0 ให้ใช้ raise ValueError พร้อมข้อความ จำนวนเงินฝากต้องมากกว่า 0
หากข้อมูลถูกต้อง ให้ใช้ else แสดงยอดเงินคงเหลือใหม่
ใช้ finally แสดงข้อความ สิ้นสุดรายการฝากเงิน เสมอ
ห้ามใช้ except: แบบไม่ระบุชนิดข้อผิดพลาด
"""
def deposit(money):
    balance = 1000

    try:
        amount = float(money)

        if amount <= 0:
            raise ValueError("จำนวนเงินฝากต้องมากกว่า 0")

    except ValueError as e:
        print(f"เกิดข้อผิดพลาด: {e}")

    else:
        balance += amount
        print(f"ฝากเงินสำเร็จ")
        print(f"ยอดเงินคงเหลือ: {balance:.2f} บาท")

    finally:
        print("สิ้นสุดรายการฝากเงิน")



print(f"ยอดเงินเริ่มต้น: 1000 บาท")
money = input("กรอกจำนวนเงินที่ต้องการฝาก: ")
deposit(money)
